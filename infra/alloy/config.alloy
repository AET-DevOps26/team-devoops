// Discovers every container on this host via the Docker socket and ships their
// logs to Loki. Local/VM only -- Kubernetes uses loki.source.kubernetes instead
// (see infra/helm/team-devoops), since there's no single shared Docker socket there.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// discovery.docker only provides __meta_docker_* labels, which loki.source.docker
// drops by default -- without this, every container's logs land in one
// indistinguishable "service_name=unknown_service" stream.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
