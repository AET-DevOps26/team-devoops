# Example environment file for py-recommender.
# Copy to `.env` and fill in real values locally. Never commit secrets.

# LLM provider: "openai" (default, needs OPENAI_API_KEY) or "ollama" (local, no key needed).
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here

# Optional overrides. Defaults: gpt-4.1-mini / text-embedding-3-large (openai),
# qwen3:0.6b / nomic-embed-text (ollama).
#LLM_MODEL=
#EMBEDDING_MODEL=
#OLLAMA_BASE_URL=http://localhost:11434
