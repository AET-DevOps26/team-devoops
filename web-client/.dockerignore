# Version control
.git/
.gitignore
.gitattributes

# Dependencies & build output (rebuilt inside container)
node_modules/
dist/
dist-ssr/
coverage/

# Local env files — never bake secrets into images
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Tests & tooling not needed for production build
src/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Docs & meta
README.md
plans/
docs/

# Docker files themselves
Dockerfile
.dockerignore
